# GeoHistory Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git (it contains secrets)

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://geohistory_user:change_this_password_12345@localhost:5432/geohistory
DB_HOST=localhost
DB_PORT=5432
DB_USER=geohistory_user
DB_PASSWORD=change_this_password_12345
DB_NAME=geohistory

# ============================================================================
# BACKEND (Express.js)
# ============================================================================
NODE_ENV=development
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# ============================================================================
# FRONTEND (Next.js)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# JWT AUTHENTICATION
# Must be at least 32 characters for production
# ============================================================================
JWT_SECRET=your-super-secret-key-must-be-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-must-be-min-32-chars-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================================================
# OPTIONAL: Email/SMTP Configuration (for future notifications)
# ============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-email-password
# SMTP_FROM=noreply@example.com

# ============================================================================
# OPTIONAL: File Upload Configuration
# ============================================================================
# MAX_FILE_SIZE=10485760
# UPLOAD_DIR=./public/uploads

# ============================================================================
# OPTIONAL: Rate Limiting
# ============================================================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Development Secrets (for local testing only - never use in production)
# ============================================================================
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=AdminPassword123
