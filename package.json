{
  "name": "geohistory",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-root.js",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev -H 0.0.0.0 -p 3000",
    "dev:backend": "cd backend && PORT=3001 npm run dev",
    "test": "jest",
    "test:frontend": "jest",
    "test:watch": "jest --watch",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "node scripts/generate_database_setup.js",
    "db:watch": "node scripts/watch_schema.js",
    "predev:all": "node scripts/check-root.js",
    "dev:all": "concurrently \"npm run db:watch\" \"npm run dev\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.12.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
