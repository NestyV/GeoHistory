
// Reemplazar el endpoint GET /api/user/preferences con:
app.get('/api/user/preferences', authenticateToken, async (req, res) => {
  try {
    console.log('🔍 GET /api/user/preferences - Usuario ID:', req.user.id);
    
    const result = await pool.query(
      'SELECT last_frame_id, last_year, last_lat, last_lng, last_zoom FROM user_preferences WHERE user_id = $1',
      [req.user.id]
    );
    
    console.log('📊 Resultado de query:', result.rows);
    console.log('📊 Cantidad de filas:', result.rows.length);
    
    if (result.rows.length === 0) {
      console.log('📭 No se encontraron preferencias para usuario:', req.user.id);
      return res.json({ hasPreferences: false });
    }
    
    console.log('✅ Preferencias encontradas:', result.rows[0]);
    res.json({
      hasPreferences: true,
      preferences: result.rows[0]
    });
  } catch (error) {
    console.error('Error fetching user preferences:', error);
    res.status(500).json({ error: 'Error al obtener preferencias' });
  }
});
